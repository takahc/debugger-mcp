{
  "name": "debugger-mcp-vscode",
  "displayName": "Debugger MCP",
  "description": "Gives AI assistants step-by-step debugging capabilities via MCP",
  "version": "0.1.0",
  "publisher": "debugger-mcp",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Debuggers", "AI"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "debuggerMcp.start",
        "title": "Debugger MCP: Start Server"
      },
      {
        "command": "debuggerMcp.stop",
        "title": "Debugger MCP: Stop Server"
      },
      {
        "command": "debuggerMcp.showAddress",
        "title": "Debugger MCP: Show Server Address"
      }
    ],
    "configuration": {
      "title": "Debugger MCP",
      "properties": {
        "debuggerMcp.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the MCP server when VSCode opens"
        },
        "debuggerMcp.port": {
          "type": "number",
          "default": 0,
          "description": "Port for the MCP server (0 = auto-assign)"
        }
      }
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:prod": "NODE_ENV=production node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "package": "pnpm run build:prod && vsce package",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@debugger-mcp/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5"
  }
}
