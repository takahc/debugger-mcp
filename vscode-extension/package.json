{
  "name": "debugger-mcp-extension",
  "displayName": "Debugger MCP Extension",
  "description": "VSCode extension that provides HTTP API for debugging operations",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "debuggerMcp.startServer",
        "title": "Start Debugger MCP HTTP Server"
      },
      {
        "command": "debuggerMcp.stopServer",
        "title": "Stop Debugger MCP HTTP Server"
      }
    ],
    "configuration": {
      "title": "Debugger MCP",
      "properties": {
        "debuggerMcp.serverPort": {
          "type": "number",
          "default": 3000,
          "description": "Port for the HTTP API server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
